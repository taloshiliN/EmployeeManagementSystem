@model List<EmployeeManagementSystem.Models.Employee>

    @{
        ViewData["Title"]= "Employees";
    }

<h1>Employees</h1>

<p>
    <a class="btn btn-primary" asp-controller="Employees" asp-action="Create">
        Add Employee
    </a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Position</th>
            <th>Department</th>
            <th>Job Title</th>
            <th>Salary</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.FirstName @employee.LastName</td>
                <td>@employee.Email</td>
                <td>@employee.Position</td>
                <td>@employee.Department?.DepartmentName</td>
                <td>@employee.JobTitle?.Title</td>
                <td>@employee.Salary.ToString("C")</td>
                <td>
                    <a class="btn btn-sm btn-info"
                       asp-controller="Employees"
                       asp-action="Details"
                       asp-route-id="@employee.Id">
                        Details
                    </a>

                    <a class="btn btn-sm btn-info"
                       asp-controller="Employees"
                       asp-action="Edit"
                       asp-route-id="@employee.Id">
                        Edit
                    </a>

                    <a class="btn btn-sm btn-info"
                       asp-controller="Employees"
                       asp-action="Delete"
                       asp-route-id="@employee.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@model EmployeeManagementSystem.ViewModels.DepartmentIndexViewModel

@{
    ViewData["Title"] = "Departments";
}

<h1>Departments</h1>

<form asp-controller="Departments" asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input name="keyword" value="@Model.Keyword" class="form-control"
               placeholder="Search name or description" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </div>
    <div class="col-auto">
        <a class="btn btn-primary" asp-controller="Departments" asp-action="Create">
            Add Department
        </a>
    </div>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Department Name</th>
            <th>Description</th>
            <th>Employees</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var department in Model.Departments)
        {
            <tr>
                <td>@department.DepartmentName</td>
                <td>@department.Description</td>
                <td>@department.EmployeeCount</td>
                <td>
                    <a class="btn btn-sm btn-info"
                       asp-controller="Departments"
                       asp-action="Details"
                       asp-route-id="@department.Id">
                        Details
                    </a>

                    <a class="btn btn-sm btn-info"
                       asp-controller="Departments"
                       asp-action="Edit"
                       asp-route-id="@department.Id">
                        Edit
                    </a>

                    <a class="btn btn-sm btn-info"
                       asp-controller="Departments"
                       asp-action="Delete"
                       asp-route-id="@department.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (var pageIndex = 1; pageIndex <= Model.TotalPages; pageIndex++)
            {
                <li class="page-item @(pageIndex == Model.PageNumber ? "active" : "")">
                    <a class="page-link"
                       asp-controller="Departments"
                       asp-action="Index"
                       asp-route-keyword="@Model.Keyword"
                       asp-route-pageNumber="@pageIndex"
                       asp-route-pageSize="@Model.PageSize">
                        @pageIndex
                    </a>
                </li>
            }
        </ul>
    </nav>
}

<p class="text-muted">@Model.TotalRecords department(s) found.</p>
@model EmployeeManagementSystem.Models.Department

@{
    ViewData["Title"] = "Delete Department";
}

<h1>Delete Department</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this Department?
</div>

<div class="card mb-3">
    <div class="card-body">
        <dl class="row">
            @* <dt class="col-sm-3">Department</dt>
            <dd class="col-sm-9">@Model.Department?.DepartmentName</dd> *@

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>
        </dl>
    </div>
</div>

<form asp-controller="Department" asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-controller="Department" asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>
